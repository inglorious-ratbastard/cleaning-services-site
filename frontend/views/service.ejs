<!DOCTYPE html>
<html>
<%- include('./partials/head.ejs') %> 
<body>

<%- include('./partials/nav.ejs') %>

<style>
  .collection-item {
    font-weight: 500 !important;
    font-style: oblique;
  }
</style>

<div class="container-abt">

  <div class="container">
    <h6 class="center-align" style="margin-top: 65px; font-weight: bold;">
      <span class="soon teal-text text-darken-2" id="cleant">
        Providing Top-Notch Local Cleaning Services
      </span>
    </h6>
  </div>

  <div class="container">
    <div class="row">
      <div class="col s12 m8 offset-m2 l6 offset-l3 center-align" id="topz">
        <p style="font-style: oblique; font-weight: 600 !important;">
           Our professional cleaning team is dedicated to delivering reliable, high-quality service for homes and businesses alike. We take pride in creating clean, comfortable spaces using proven methods and careful attention to detail. Whether you need routine maintenance, deep cleaning, or a customized service plan, our experienced staff works hard to exceed expectations. Customer satisfaction is our priority, and we strive to provide dependable results that leave every space looking its best.
        </p>
      </div>
    </div>
  </div>

  <div class="container" id="servfm">
    <div class="row">

      <div class="col s12 m6">
        <ul class="collection with-header">
          <li class="collection-header center-align">
            <h6 style="text-decoration: underline;">Residential Cleaning Services</h6>
          </li>
           <li class="collection-item center-align">Recurring weekly and bi-weekly home cleaning.</li>
           <li class="collection-item center-align">Deep cleaning for kitchens, bathrooms, and living areas.</li>
           <li class="collection-item center-align">Move-in and move-out residential cleaning services.</li>
           <li class="collection-item center-align">Apartment, condo, and single-family home cleaning.</li>
           <li class="collection-item center-align">Customized cleaning plans tailored to your needs.</li>
        </ul>
      </div>

      <div class="col s12 m6">
        <ul class="collection with-header">
          <li class="collection-header center-align">
            <h6 style="text-decoration: underline;">Commercial Cleaning Services</h6>
          </li>
            <li class="collection-item center-align">Professional office cleaning for a spotless workplace.</li>
            <li class="collection-item center-align">Retail store and customer-facing space maintenance.</li>
            <li class="collection-item center-align">Janitorial services for businesses of all sizes.</li>
            <li class="collection-item center-align">After-hours cleaning to minimize business disruption.</li>
            <li class="collection-item center-align">Customized commercial cleaning schedules available.</li>
        </ul>
      </div>

    </div>
  </div>

</div>

<div class="container center-align" id="callz">

  <div class="row valign-wrapper">
    <div class="col s12 center-align hide-on-small-only">
      <h6 style="font-weight: bold;">Locally Owned and Licensed</h6>
    </div>

    <div class="col s12 m4 center-align">
      <span class="material-symbols-outlined tooltipped"
            data-position="bottom"
            data-tooltip="I am a tooltip"
            style="font-size: 30px; color: #3CB371;">
        home_work
      </span>
    </div>

    <div class="col s12 center-align hide-on-small-only">
      <h6 style="font-weight: bold;">Guaranteed and Respected</h6>
    </div>

    <div class="col s12 show-on-small hide-on-med-and-up center-align">
      <h6>Locally Owned and Licensed</h6>
      <h6>Guaranteed and Respected</h6>
    </div>
  </div>

  <p class="teal-text text-lighten-1"
     style="margin-top: 35px; font-weight: bold;">
    We're Waiting To Hear From You
  </p>

  <div style="margin-top: 15px;">
    <a href="tel:+1-401-555-1125" class="btn-small">
      <i class="fa-solid fa-phone"></i>&nbsp;Call Us
    </a>
  </div>

  <p class="rateft"
     style="font-size: 13px; max-width: 300px; margin: 20px auto 0; font-weight: bold;">
    Contact us now to schedule a cleaning date, get a quote, or speak to one of our associates.
    We're looking forward working with you soon.
  </p>

</div>

<div style="margin-bottom: 65px;"></div>

<%- include('./partials/footer.ejs') %> 

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script> 

<%- include('./partials/scripts.ejs') %>

</body>
</html>